# Local development configuration. Never commit real secrets.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Generate a private value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Optional isolated MongoDB database for integration tests. Leave blank to skip database integration tests.
MONGODB_TEST_URI=
